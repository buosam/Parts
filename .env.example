# ==========================================
# IQAutoMarket Environment Configuration
# ==========================================

# --- 1. CORE SYSTEM ---
NODE_ENV=production
PORT=3000
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

# --- 2. SECURITY & AUTHENTICATION SECRETS ---
# Note: Password salts are uniquely generated per-user and stored in PostgreSQL.
# SESSION_SECRET / JWT_SECRET is used for signing session tokens and API webhooks.
SESSION_SECRET=c29tZV9zdXBlcl9zZWN1cmVfcmFuZG9tXzMyX2J5dGVfc2VjcmV0X2tleQ==
JWT_SECRET=aXFfYXV0b21hcmtldF9wcm9kdWN0aW9uX2p3dF9zZWNyZXRfa2V5XzIwMjY=
AUTH_PEPPER=aXFfYXV0b19wZXBwZXJfc2VjdXJpdHlfa2V5

# --- 3. DATABASE (Railway PostgreSQL) ---
# Railway automatically injects DATABASE_URL when a PostgreSQL service is added.
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway
PGHOST=postgres.railway.internal
PGPORT=5432
PGUSER=postgres
PGPASSWORD=password
PGDATABASE=railway

# --- 4. GOOGLE GEMINI AI (Part Visual OCR & Search) ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# --- 5. OPTIONAL: WHATSAPP CLOUD API (For Real SMS/WhatsApp OTP in Production) ---
# If omitted, IQAutoMarket runs in Sandbox Mode (OTP displays in UI console/response).
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# --- 6. OPTIONAL: PAYTABS IRAQ / REGIONAL PAYMENT GATEWAY ---
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
PAYTABS_CLIENT_KEY=
PAYTABS_CURRENCY=IQD
